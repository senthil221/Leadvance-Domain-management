APP_HOST=domains.srv1826728.hstgr.cloud
# Name and icon in the app: leadvance (Leadvance Domains) or b2bdrive (B2bdrive Domains)
APP_BRAND=leadvance
# The Docker network of the Traefik that serves HTTPS on this VPS (docker network ls)
TRAEFIK_NETWORK=n8n_default

# The app's own Postgres role (see DEPLOY.md, step 3)
DATABASE_URL=postgres://domain_engine:CHANGE_ME@supabase-db:5432/postgres

# From /docker/domain-engine-db/.env on the VPS (ANON_KEY, SERVICE_ROLE_KEY)
SUPABASE_URL=http://api-gw:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
UNSTOPPABLE_API_KEY=
SMARTLEAD_API_KEY=
HYPERTIDE_API_KEY=
SMARTLEAD_WEBHOOK_TOKEN=

# Keep true until each integration has been tested on one real domain
INTEGRATIONS_DRY_RUN=true

# Postgres: local PGlite (npm run db:dev) or the VPS Supabase db over an SSH tunnel
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Supabase Auth (GoTrue) behind the self-hosted API gateway
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: skip login and act as this user
DEV_AUTH_EMAIL=you@example.com

# Integrations (server-side only)
# Registrar accounts are added in Settings; Porkbun can also live here
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
SMARTLEAD_API_KEY=
# Optional: the token after "Bearer " in a Smartlead web app request. Tags,
# block list scans and reconnecting inboxes use Smartlead's app API, which the
# API key can't reach
# SMARTLEAD_JWT=
HYPERTIDE_API_KEY=
# Optional: defaults to https://backend.hypertide.io/api/v1
# HYPERTIDE_API_URL=
# The Smartlead login Hypertide connects new inboxes with (OAuth link: Microsoft plan only)
# HYPERTIDE_SMARTLEAD_USERNAME=
# HYPERTIDE_SMARTLEAD_PASSWORD=
# HYPERTIDE_SMARTLEAD_OAUTH_LINK=
# The Smartlead login Icemail exports new inboxes with (defaults to the Hypertide one above)
# ICEMAIL_SMARTLEAD_USERNAME=
# ICEMAIL_SMARTLEAD_PASSWORD=
# Optional: turns on the Diagnose button on the domain page (openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional: any model on OpenRouter. Defaults to deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_MODEL=
# Optional: an OpenRouter-compatible endpoint instead of openrouter.ai
# OPENROUTER_BASE_URL=
# Secret part of the Smartlead webhook URL: /api/webhooks/smartlead/<token>
SMARTLEAD_WEBHOOK_TOKEN=
# Secret part of the sheet feed URL: /api/sheet/<token> (16+ characters)
SHEET_SYNC_TOKEN=

# true = log external calls without sending them
INTEGRATIONS_DRY_RUN=true

# Optional: encrypts registrar keys saved in Settings (defaults to SUPABASE_SERVICE_ROLE_KEY).
# Changing it, or the service key it falls back to, makes saved keys unreadable
# CREDENTIALS_SECRET=

# Optional: Postgres pool sizes for the app (default 10) and the jobs it runs (default 3)
# DATABASE_POOL_MAX=
# DATABASE_JOB_POOL_MAX=
